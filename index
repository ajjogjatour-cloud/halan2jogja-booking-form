<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Booking Card — Halan2Jogja Tour</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#0b1209;
    --panel:#10180d;
    --panel-2:#161f12;
    --card:#f6f5ef;
    --green:#5fa83d;
    --green-deep:#3d7a28;
    --green-soft:#9fd17e;
    --stone:#b9b6a8;
    --line:rgba(255,255,255,0.08);
    --shadow:0 20px 40px rgba(0,0,0,0.45);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:
      radial-gradient(circle at 50% -10%, rgba(95,168,61,0.18), transparent 60%),
      var(--ink);
    min-height:100vh;
    font-family:'Inter',sans-serif;
    color:var(--card);
    display:flex;
    justify-content:center;
    padding:0;
  }
  .frame{
    width:100%;
    max-width:430px;
    min-height:100vh;
    background:linear-gradient(180deg, var(--panel) 0%, var(--ink) 100%);
    display:flex;
    flex-direction:column;
    position:relative;
    overflow-x:hidden;
  }
  /* Header */
  .header{
    padding:28px 22px 18px;
    text-align:center;
    position:relative;
  }
  .header::after{
    content:"";
    position:absolute;
    left:50%;
    bottom:0;
    transform:translateX(-50%);
    width:60%;
    height:1px;
    background:linear-gradient(90deg, transparent, var(--line), transparent);
  }
  .logo{
    width:150px;
    height:auto;
    margin:0 auto 6px;
    display:block;
    filter:drop-shadow(0 6px 14px rgba(0,0,0,0.5));
  }
  .eyebrow{
    font-size:10.5px;
    letter-spacing:0.22em;
    text-transform:uppercase;
    color:var(--green-soft);
    font-weight:600;
    margin-top:4px;
  }
  .title{
    font-family:'Fraunces',serif;
    font-weight:600;
    font-size:22px;
    margin:6px 0 2px;
    color:var(--card);
    letter-spacing:0.01em;
  }
  .subtitle{
    font-size:12px;
    color:var(--stone);
    margin:0;
    line-height:1.5;
  }

  /* Form section */
  .form-wrap{
    flex:1;
    padding:18px 20px 10px;
  }
  .field{
    margin-bottom:16px;
  }
  .field label{
    display:flex;
    align-items:center;
    gap:6px;
    font-size:11.5px;
    font-weight:600;
    letter-spacing:0.03em;
    color:var(--green-soft);
    text-transform:uppercase;
    margin-bottom:7px;
  }
  .field label .num{
    color:var(--stone);
    font-weight:500;
    font-family:'Fraunces',serif;
    font-style:italic;
    font-size:12px;
  }
  input[type=text],
  input[type=tel],
  input[type=date],
  textarea,
  select{
    width:100%;
    background:var(--card);
    border:1px solid transparent;
    border-radius:10px;
    padding:12px 13px;
    font-family:'Inter',sans-serif;
    font-size:14.5px;
    color:#1a1a1a;
    outline:none;
    transition:box-shadow .2s, transform .15s;
    -webkit-appearance:none;
    appearance:none;
  }
  textarea{
    resize:vertical;
    min-height:78px;
    line-height:1.45;
  }
  input::placeholder, textarea::placeholder{
    color:#8b8a80;
  }
  input:focus, textarea:focus, select:focus{
    box-shadow:0 0 0 3px rgba(95,168,61,0.35);
  }
  select{
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='8'><path d='M0 0L7 8L14 0' fill='%233d7a28'/></svg>");
    background-repeat:no-repeat;
    background-position:right 14px center;
    padding-right:32px;
    cursor:pointer;
  }

  /* Duration pills */
  .pill-group{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
  }
  .pill{
    flex:1 1 auto;
    min-width:54px;
    text-align:center;
    padding:10px 6px;
    border-radius:9px;
    background:var(--panel-2);
    border:1px solid var(--line);
    color:var(--card);
    font-size:13px;
    font-weight:600;
    cursor:pointer;
    transition:all .15s;
  }
  .pill.active{
    background:linear-gradient(135deg, var(--green) 0%, var(--green-deep) 100%);
    border-color:var(--green);
    color:#0b1209;
    transform:translateY(-1px);
    box-shadow:0 6px 14px rgba(95,168,61,0.35);
  }

  /* Unit cards */
  .unit-group{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:9px;
  }
  .unit-card{
    background:var(--panel-2);
    border:1px solid var(--line);
    border-radius:11px;
    padding:11px 10px;
    cursor:pointer;
    transition:all .15s;
  }
  .unit-card .uc-name{
    font-size:13.5px;
    font-weight:700;
    color:var(--card);
    margin-bottom:2px;
  }
  .unit-card .uc-desc{
    font-size:10.5px;
    color:var(--stone);
    line-height:1.3;
  }
  .unit-card.active{
    background:linear-gradient(135deg, rgba(95,168,61,0.22), rgba(61,122,40,0.32));
    border-color:var(--green);
    box-shadow:0 0 0 1px var(--green) inset;
  }
  .unit-card.active .uc-name{ color:var(--green-soft); }

  .hint{
    font-size:10.5px;
    color:var(--stone);
    margin-top:6px;
    line-height:1.4;
  }

  .note-box{
    margin:6px 0 18px;
    background:rgba(95,168,61,0.08);
    border:1px solid rgba(95,168,61,0.25);
    border-radius:10px;
    padding:11px 13px;
    font-size:11.5px;
    color:var(--green-soft);
    line-height:1.5;
  }

  /* Footer / submit */
  .footer{
    padding:14px 20px 26px;
    position:sticky;
    bottom:0;
    background:linear-gradient(180deg, transparent, var(--ink) 35%);
  }
  .submit-btn{
    width:100%;
    border:none;
    border-radius:13px;
    padding:16px;
    font-family:'Inter',sans-serif;
    font-size:15px;
    font-weight:700;
    letter-spacing:0.01em;
    color:#0b1209;
    background:linear-gradient(135deg, var(--green-soft) 0%, var(--green) 55%, var(--green-deep) 100%);
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:9px;
    box-shadow:0 14px 28px rgba(95,168,61,0.32);
    transition:transform .15s, box-shadow .15s;
  }
  .submit-btn:active{
    transform:translateY(1px) scale(0.99);
    box-shadow:0 8px 16px rgba(95,168,61,0.3);
  }
  .submit-btn svg{ width:18px; height:18px; flex-shrink:0; }
  .footer-note{
    text-align:center;
    font-size:10px;
    color:var(--stone);
    margin-top:10px;
    letter-spacing:0.02em;
  }
  .error-msg{
    color:#e98787;
    font-size:11px;
    margin-top:8px;
    text-align:center;
    min-height:14px;
  }

  ::selection{ background:var(--green); color:#0b1209; }
</style>
</head>
<body>
<div class="frame">

  <div class="header">
    <img class="logo" src="data:image/png;base64," alt="Halan2Jogja Tour">
    <div class="eyebrow">Booking Card</div>
    <div class="subtitle">Isi data perjalananmu, kami siapkan unit &amp; driver terbaik.</div>
  </div>

  <div class="form-wrap">

    <div class="field">
      <label><span class="num">01</span> Nama</label>
      <input type="text" id="nama" placeholder="Nama lengkap pemesan">
    </div>

    <div class="field">
      <label><span class="num">02</span> Nomor WhatsApp</label>
      <input type="tel" id="wa" placeholder="08xxxxxxxxxx">
    </div>

    <div class="field">
      <label><span class="num">03</span> Tanggal</label>
      <input type="date" id="tanggal">
    </div>

    <div class="field">
      <label><span class="num">04</span> Lokasi Jemput</label>
      <input type="text" id="lokasi" placeholder="Cth: Hotel Arkadewi Prawirotama">
    </div>

    <div class="field">
      <label><span class="num">05</span> Durasi Wisata</label>
      <div class="pill-group" id="durasiGroup">
        <div class="pill" data-val="4 Jam">4 Jam</div>
        <div class="pill" data-val="6 Jam">6 Jam</div>
        <div class="pill" data-val="8 Jam">8 Jam</div>
        <div class="pill" data-val="10 Jam">10 Jam</div>
        <div class="pill" data-val="12 Jam">12 Jam</div>
      </div>
    </div>

    <div class="field">
      <label><span class="num">06</span> Tujuan Wisata</label>
      <textarea id="tujuan" placeholder="Tulis daftar destinasi yang ingin dikunjungi, cth:&#10;- Pantai Watulawang&#10;- Candi Prambanan&#10;- Belanja oleh-oleh"></textarea>
    </div>

    <div class="field">
      <label><span class="num">07</span> Unit Kendaraan</label>
      <div class="unit-group" id="unitGroup">
        <div class="unit-card" data-val="Toyota Calya">
          <div class="uc-name">Toyota Calya</div>
          <div class="uc-desc">Irit &amp; lincah, max 5 org</div>
        </div>
        <div class="unit-card" data-val="Avanza New">
          <div class="uc-name">Avanza New</div>
          <div class="uc-desc">Nyaman, max 6 org</div>
        </div>
        <div class="unit-card" data-val="Reborn">
          <div class="uc-name">Reborn</div>
          <div class="uc-desc">Premium, max 6 org</div>
        </div>
        <div class="unit-card" data-val="Hiace">
          <div class="uc-name">Hiace</div>
          <div class="uc-desc">Rombongan, max 14 org</div>
        </div>
      </div>
    </div>

    <div class="note-box">
      Biaya &amp; ketersediaan unit akan dikonfirmasi langsung oleh admin Halan2Jogja melalui WhatsApp setelah form ini terkirim.
    </div>

  </div>

  <div class="footer">
    <button class="submit-btn" id="submitBtn">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.6 6.32A8.86 8.86 0 0 0 12.05 4a8.94 8.94 0 0 0-7.7 13.46L3 22l4.65-1.32a8.9 8.9 0 0 0 4.4 1.15h.01A8.94 8.94 0 0 0 21 13.05a9 9 0 0 0-3.4-6.73Zm-5.55 13.62a7.4 7.4 0 0 1-3.77-1.03l-.27-.16-2.8.8.8-2.73-.17-.28a7.43 7.43 0 0 1 11.6-9.05 7.4 7.4 0 0 1 2.18 5.27 7.45 7.45 0 0 1-7.57 7.18Zm4.07-5.56c-.22-.11-1.3-.64-1.5-.71-.2-.07-.35-.11-.5.11-.15.22-.57.71-.7.86-.13.15-.26.16-.48.05-.22-.11-.93-.34-1.77-1.1a6.6 6.6 0 0 1-1.22-1.51c-.13-.22-.01-.34.1-.45.11-.11.25-.28.37-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.03-.42-.07-.11-.6-1.45-.82-1.98-.22-.52-.45-.45-.62-.46-.16-.01-.35-.01-.54-.01-.19 0-.49.07-.75.34-.26.27-1 1-1 2.43 0 1.43 1.03 2.81 1.17 3 .14.19 1.96 3 4.75 4.08 2.79 1.09 2.79.73 3.29.68.5-.05 1.61-.66 1.84-1.3.23-.64.23-1.18.16-1.3-.07-.11-.22-.17-.44-.28Z"/></svg>
      Kirim Booking via WhatsApp
    </button>
    <div class="error-msg" id="errMsg"></div>
    <div class="footer-note">HALAN2JOGJA TOUR &nbsp;·&nbsp; Jogja, Indonesia</div>
  </div>

</div>

<script>
  const durasiGroup = document.getElementById('durasiGroup');
  const unitGroup = document.getElementById('unitGroup');
  let selectedDurasi = null;
  let selectedUnit = null;

  durasiGroup.querySelectorAll('.pill').forEach(p=>{
    p.addEventListener('click', ()=>{
      durasiGroup.querySelectorAll('.pill').forEach(x=>x.classList.remove('active'));
      p.classList.add('active');
      selectedDurasi = p.dataset.val;
    });
  });

  unitGroup.querySelectorAll('.unit-card').forEach(c=>{
    c.addEventListener('click', ()=>{
      unitGroup.querySelectorAll('.unit-card').forEach(x=>x.classList.remove('active'));
      c.classList.add('active');
      selectedUnit = c.dataset.val;
    });
  });

  function formatTanggal(iso){
    if(!iso) return '';
    const d = new Date(iso + 'T00:00:00');
    const bulan = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
    return d.getDate() + ' ' + bulan[d.getMonth()] + ' ' + d.getFullYear();
  }

  document.getElementById('submitBtn').addEventListener('click', ()=>{
    const nama = document.getElementById('nama').value.trim();
    const wa = document.getElementById('wa').value.trim();
    const tanggal = document.getElementById('tanggal').value;
    const lokasi = document.getElementById('lokasi').value.trim();
    const tujuan = document.getElementById('tujuan').value.trim();
    const errEl = document.getElementById('errMsg');

    if(!nama || !wa || !tanggal || !lokasi || !tujuan || !selectedDurasi || !selectedUnit){
      errEl.textContent = 'Mohon lengkapi semua data sebelum mengirim.';
      return;
    }
    errEl.textContent = '';

    const tujuanLines = tujuan.split('\n').map(l=>l.trim()).filter(l=>l.length>0)
      .map(l=> l.startsWith('-') ? l : '- ' + l).join('\n');

    const msg =
`Booking Card Halan2Jogja

Nama : ${nama}
Nomor Whatsapp : ${wa}
Tanggal : ${formatTanggal(tanggal)}
Lokasi jemput : ${lokasi}
Durasi Wisata : ${selectedDurasi}
Unit : ${selectedUnit}
Tujuan :
${tujuanLines}

(Biaya akan dikonfirmasi admin)`;

    const adminNumber = '6285136995054';
    const url = `https://wa.me/${adminNumber}?text=${encodeURIComponent(msg)}`;
    window.open(url, '_blank');
  });
</script>
</body>
</html>
